# デモモード。true の間はログインなしで全機能を使えます（提出用の初期値）。
# クライアントが本番でアカウント管理を有効化する時に false へ変更します。
DEMO_MODE=true

# PostgreSQL（Supabaseなど）の接続文字列を設定します。
# 例: postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# カンマ区切り。NetlifyのURLとローカル開発URLを登録します。
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# 32文字以上の予測困難なランダム文字列に変更してください。
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480

# trueの場合、起動時に不足しているテーブルを作ります。
AUTO_CREATE_TABLES=true

# 初回起動時だけ使用する初期管理者。作成後はPASSWORDを環境変数から削除してください。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
